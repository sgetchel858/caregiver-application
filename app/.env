# Committed defaults for every build. These are public identifiers, not
# secrets (an Auth0 SPA has no client secret). Sign-in stays OFF until
# VITE_AUTH=auth0 is set: in .env.local for local dev, or the VITE_AUTH
# repository variable for the GitHub Pages build.
VITE_AUTH0_DOMAIN=attrilock.us.auth0.com
VITE_AUTH0_CLIENT_ID=FvcAVmxvrD82gwmdz7KCTfA8PujxwRHm
VITE_AUTH0_AUDIENCE=https://sil-api
# Cognatum is reached through the Casanté proxy (supabase/functions/sil): its
# CORS allowlist doesn't include the demo's origin. Local dev overrides this with
# the Vite proxy in .env.local (needed for seeding, which the proxy doesn't allow).
VITE_SIL_API_URL=https://tunftqvetfqgmmjsnjkb.supabase.co/functions/v1/sil
VITE_SIL_TENANT=casante
# Supabase app store (used when VITE_APP_STORE=supabase). The publishable key
# is public by design; row-level security protects the data.
VITE_SUPABASE_URL=https://tunftqvetfqgmmjsnjkb.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_RMN40OwbYqBM-mw5YfZM3A_1SGfvi2e
