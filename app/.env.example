# Copy to .env.local to override. Everything here ends up in the public bundle:
# never put secrets in VITE_* variables.

# Sub-path the site is served from (GitHub Pages: /<repo>/). Default "/".
# VITE_BASE=/casante-demo/

# Health API: "mock" (fixtures, default) or "live" (fetch client).
VITE_HEALTH_API=mock
# Base URL of the live Health API, used only when VITE_HEALTH_API=live.
# VITE_HEALTH_API_URL=https://api.example.com/v1

# App store: "mock" (in-browser, default) or "supabase" (the Casanté Supabase
# project; needs VITE_AUTH=auth0, because Supabase identifies the user by their
# Auth0 sign-in).
VITE_APP_STORE=mock
# The Supabase project URL and its publishable key (public by design; data is
# protected by row-level security). Both are set in .env.
# VITE_SUPABASE_URL=https://tunftqvetfqgmmjsnjkb.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ---- Sign-in + Cognatum (SIL) API ---------------------------------------
# "none" (default, offline demo) or "auth0": sign in with the Cognatum
# account (Auth0 Universal Login) and call the Cognatum API as that user.
# VITE_AUTH=auth0
# Auth0 tenant domain and the caregiver app's own "Single Page Application"
# client id. Both are public identifiers, not secrets.
# VITE_AUTH0_DOMAIN=attrilock.us.auth0.com   (set in .env)
# VITE_AUTH0_CLIENT_ID=FvcAVmxvrD82gwmdz7KCTfA8PujxwRHm   (set in .env)
# The Cognatum API audience (default https://sil-api).
# VITE_AUTH0_AUDIENCE=https://sil-api
# Where tokens are kept: "localstorage" (default; survives reloads on iPhone)
# or "memory" (sign in again after every reload).
# VITE_AUTH0_CACHE=localstorage

# Cognatum API base URL. Hosted build: the full URL. Local dev: "/api/v1" plus
# SIL_PROXY_TARGET below, because beta's CORS never allows localhost.
# VITE_SIL_API_URL=https://app.cognatum-demo.com/api/v1
# VITE_SIL_API_URL=/api/v1
# SIL_PROXY_TARGET=https://app.cognatum-demo.com
# The workspace to call: its slug (e.g. casante) or its tenant UUID.
# VITE_SIL_TENANT=casante

# Drug interaction checks call RxNorm and openFDA from the browser. openFDA allows 1,000
# requests a day per IP without a key; a free key (open.fda.gov/apis/authentication) raises that.
# VITE_OPENFDA_API_KEY=
